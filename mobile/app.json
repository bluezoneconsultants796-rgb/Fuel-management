{
  "expo": {
    "name": "Fleet Fuel Manager",
    "slug": "fleet-fuel-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fleetfuel",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "backgroundColor": "#1C3F60",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.fleet.fuelmanager",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Fleet Fuel Manager needs camera access to photograph fuel slips."
        }
      ],
      "expo-document-picker"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "baseUrl": "/Fuel-management"
    },
    "extra": {
      "eas": {
        "projectId": "9eecde04-5503-428f-87a1-1f6b96003800"
      }
    }
  }
}
