# ---------------------------------------------------------------------------
# Fuel Expense & Slip Management System — Backend environment
# Copy this file to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000

# Database (PostgreSQL — works with Neon, Supabase, Railway, or a local server)
# DATABASE_URL : connection string the app uses at runtime (Neon: the "pooled" URL)
# DIRECT_URL   : direct (non-pooled) connection used by `prisma migrate`
#                (if you are not using a pooler, set it to the same value as DATABASE_URL)
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require"

# Authentication
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_MIN_16_CHARS
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
LOGIN_RATE_LIMIT_MAX=20

# CORS — comma-separated origins (e.g. http://localhost:19006,http://localhost:3000) or * for all
CORS_ORIGIN=*

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Public base URL used when building absolute slip-file URLs returned to the
# mobile app (leave empty to use the incoming request host).
PUBLIC_BASE_URL=

# OCR provider: "tesseract" (local, no key needed) or "google-vision"
OCR_PROVIDER=tesseract
GOOGLE_VISION_API_KEY=
