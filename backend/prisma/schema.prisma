generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  ACCOUNTANT
  DRIVER
}

enum FuelType {
  PETROL
  DIESEL
}

enum FuelEntryStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique
  phone        String   @default("") @db.VarChar(20)
  passwordHash String   @map("password_hash")
  role         Role
  driverId     String?  @map("driver_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  driver Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@unique([driverId])
  @@map("users")
}

model Driver {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @db.VarChar(100)
  phone             String
  employeeId        String   @unique @map("employee_id") @db.VarChar(30)
  assignedVehicleId String?  @map("assigned_vehicle_id") @db.Uuid
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  assignedVehicle Vehicle?    @relation("DriverAssignedVehicle", fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  vehicles        Vehicle[]   @relation("VehicleAssignedDriver")
  users           User[]
  fuelEntries     FuelEntry[]

  @@map("drivers")
}

model Vehicle {
  id               String   @id @default(uuid()) @db.Uuid
  vehicleNumber    String   @unique @map("vehicle_number") @db.VarChar(20)
  vehicleType      String   @map("vehicle_type") @db.VarChar(50)
  model            String   @db.VarChar(100)
  assignedDriverId String?  @map("assigned_driver_id") @db.Uuid
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  assignedDriver Driver?     @relation("VehicleAssignedDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  drivers        Driver[]    @relation("DriverAssignedVehicle")
  fuelEntries    FuelEntry[]

  @@map("vehicles")
}

model FuelEntry {
  id               String          @id @default(uuid()) @db.Uuid
  driverId         String          @map("driver_id") @db.Uuid
  vehicleId        String          @map("vehicle_id") @db.Uuid
  date             DateTime
  time             String          @default("") @db.VarChar(8)
  petrolPumpName   String          @map("petrol_pump_name") @db.VarChar(150)
  vehicleNumber    String          @map("vehicle_number") @db.VarChar(20)
  fuelType         FuelType        @map("fuel_type")
  liters           Float
  pricePerLiter    Float           @map("price_per_liter")
  totalAmount      Float           @map("total_amount")
  receiptNumber    String          @map("receipt_number") @db.VarChar(50)
  slipImageUrl     String          @default("") @map("slip_image_url") @db.VarChar(500)
  originalFileName String          @default("") @map("original_file_name") @db.VarChar(255)
  ocrRawText       String          @default("") @map("ocr_raw_text") @db.Text
  ocrConfidence    Float?          @map("ocr_confidence")
  status           FuelEntryStatus @default(PENDING)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  driver  Driver  @relation(fields: [driverId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([driverId])
  @@index([vehicleId])
  @@index([date])
  @@index([receiptNumber])
  @@index([status])
  @@index([date, createdAt])
  @@map("fuel_entries")
}
